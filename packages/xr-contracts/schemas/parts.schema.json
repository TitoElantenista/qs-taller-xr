{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.qs-xr.invalid/v1/parts.schema.json",
  "title": "QS XR assembly parts",
  "type": "object",
  "required": ["schemaVersion", "assemblyGuid", "parts"],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "assemblyGuid": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "guid",
          "positionNumber",
          "kind",
          "gltfNodeName",
          "boundsAssemblyM",
          "inspectable"
        ],
        "properties": {
          "guid": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "positionNumber": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "kind": {
            "enum": ["MAIN_PART", "SECONDARY_PART", "PLATE", "BOLT_GROUP", "FABRICATION_MARK", "OTHER"]
          },
          "gltfNodeName": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "boundsAssemblyM": {
            "$ref": "common.schema.json#/$defs/aabb"
          },
          "inspectable": {
            "type": "boolean"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
