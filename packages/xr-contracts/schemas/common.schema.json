{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.qs-xr.invalid/v1/common.schema.json",
  "title": "QS XR common definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "ifcGlobalId": {
      "type": "string",
      "pattern": "^[0-3][0-9A-Za-z_$]{21}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix4x4": {
      "description": "Rigid parentFromChild transform in column-major order. Translation uses the unit declared by the containing document.",
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "const": 0 },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "const": 0 },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "const": 0 },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "const": 1 }
      ],
      "items": false,
      "minItems": 16,
      "maxItems": 16
    },
    "aabb": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
