{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.qs-xr.invalid/v1/source-manifest.schema.json",
  "title": "QS XR normalized assembly source manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "generatedAt",
    "project",
    "assembly",
    "source",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "producer": {
      "enum": ["IFC_SCRIPT", "TEKLA_PLUGIN"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "required": ["name", "sourceGlobalId"],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sourceGlobalId": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "assembly": {
      "type": "object",
      "required": [
        "positionNumber",
        "numberingStatus",
        "drawingNumber",
        "occurrenceCount",
        "partCount"
      ],
      "properties": {
        "positionNumber": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "numberingStatus": {
          "enum": ["CURRENT", "QUESTIONABLE"]
        },
        "drawingNumber": {
          "type": ["string", "null"]
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "partCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "system",
        "schema",
        "originalFile",
        "lengthUnit",
        "unitScaleToMetres"
      ],
      "properties": {
        "system": {
          "enum": ["IFC", "TEKLA"]
        },
        "schema": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "originalFile": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "application": {
          "type": ["string", "null"]
        },
        "lengthUnit": {
          "enum": ["mm", "m"]
        },
        "unitScaleToMetres": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["ifc", "parts", "occurrences", "checksums"],
      "properties": {
        "ifc": { "const": "assembly.ifc" },
        "parts": { "const": "parts.json" },
        "occurrences": { "const": "occurrences.json" },
        "checksums": { "const": "checksums.json" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
