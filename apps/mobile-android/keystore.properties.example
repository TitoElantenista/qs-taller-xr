# Kopieren nach keystore.properties (wird NICHT eingecheckt) und ausfüllen.
# Upload-Schlüssel erzeugen:
#   keytool -genkeypair -v -keystore qs-upload.jks -alias qs-upload -keyalg RSA -keysize 4096 -validity 10000
# Den Keystore und die Passwörter sicher außerhalb des Repos aufbewahren: ohne ihn sind keine Updates möglich.
storeFile=/absoluter/pfad/zu/qs-upload.jks
storePassword=
keyAlias=qs-upload
keyPassword=
# Alternativ: Passwortdateien (erste Zeile), damit hier keine Passwörter stehen müssen.
# storePasswordFile=/absoluter/pfad/zur/passwortdatei
# keyPasswordFile=/absoluter/pfad/zur/passwortdatei
